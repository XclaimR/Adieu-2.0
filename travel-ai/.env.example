# Copy to .env and fill in. Never commit .env.

# "production" (the default) refuses to start with a weak SESSION_SECRET, the default database password or
# ALLOW_DEV_LOGIN on. On your own machine use development.
APP_ENV=development

# At least 32 random characters, e.g. the output of: openssl rand -hex 32
SESSION_SECRET=
# Database password. Letters and digits only (it goes into a URL), e.g.: openssl rand -hex 24
# Read only when the Postgres volume is first created. Locally you can leave it unset (defaults to postgres).
POSTGRES_PASSWORD=

GOOGLE_OAUTH_CLIENT_ID=
# Browser origins allowed to call the API, comma-separated (production: your https:// address).
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# LLM: any OpenAI-compatible provider. Left commented, the app uses local Ollama (qwen3:8b).
# Recommended: uncomment for Gemini's free tier (fast; free-tier prompts may be used by Google) and add your key.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=
# LLM_REASONING_EFFORT=    # empty: gemini-3.5-flash-lite rejects the parameter

# Email-only sign-in for local development. Refused when APP_ENV=production.
ALLOW_DEV_LOGIN=false
