# Copy to .env and fill in. Never commit .env.
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
# LLM: any OpenAI-compatible provider. Recommended: Gemini free tier (fast; free-tier prompts may be used by Google).
# Leave these four out to use local Ollama (qwen3:8b) instead.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# gemini-3.5-flash-lite rejects reasoning_effort, so keep this empty for it.
LLM_REASONING_EFFORT=
# Email-only sign-in for local development. Keep false anywhere public.
ALLOW_DEV_LOGIN=false
