# Copy to .env and fill in. Never commit .env.
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
# Any OpenAI-compatible provider; defaults to local Ollama (qwen3:8b) in docker-compose.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Email-only sign-in for local development. Keep false anywhere public.
ALLOW_DEV_LOGIN=false
